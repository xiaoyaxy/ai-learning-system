{
  "name": "ai-learning-web-e2e",
  "main": "../../../apps/web/worker.ts",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "assets": {
    "directory": "../../../apps/web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "services": [{ "binding": "API", "service": "ai-learning-api-e2e" }],
}
