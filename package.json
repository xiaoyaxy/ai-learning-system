{
  "name": "ai-learning-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev -c apps/api/wrangler.jsonc -c apps/web/wrangler.jsonc",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.2",
    "agents": "0.28.0",
    "hono": "4.13.13",
    "jose": "6.2.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261014.1",
    "@playwright/test": "1.64.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.0",
    "wrangler": "4.149.0",
    "@cloudflare/vitest-plugin": "1.4.0"
  },
  "packageManager": "npm@11.21.0"
}
