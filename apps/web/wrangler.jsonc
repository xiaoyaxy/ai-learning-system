{
  "name": "ai-learning-web",
  "account_id": "72d69b8b29c0213ad4a202b6900a8569",
  "main": "worker.ts",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "services": [
    {
      "binding": "API",
      "service": "ai-learning-api",
    },
  ],
  "workers_dev": true,
}
