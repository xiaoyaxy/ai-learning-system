{
  "name": "ai-learning-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": {
    "DEPLOYMENT_ENV": "cloud",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-learning",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "src/db/migrations",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PROJECT_SUPERVISOR",
        "class_name": "ProjectSupervisor",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ProjectSupervisor"],
    },
  ],
  "observability": {
    "enabled": true,
  },
}
